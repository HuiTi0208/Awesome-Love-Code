$(function() {
    $('#yes').click(function(event) {
        modal('我就知道小公主一定願意哒(^_^)', function() {
            $('.page_one').addClass('hide');
            $('.page_two').removeClass('hide');
            // typeWrite();
            fireworks();

        });
    });
    $('#no').click(function(event) {
        modal('有妳陪著我', A);
    });
});

function A() {
    modal('我很開心', B);
}

function B() {
    modal('我希望之後的每天', C);
}

function C() {
    modal('都能夠有妳', D);
}

function D() {
    modal('我對妳的愛', E);
}

function E() {
    modal('永遠都不會改變!', function() {
        fireworks();
    });
}

function fireworks() {
    $('.page_one').addClass('hide');
    initAnimate();
}

function modal(content, callback) {
    var tpl = '<div class="container">'+
        '<div class="mask"></div>'+
        '<div class="modal">'+
        '<p>'+ content +'</p>'+
        '<button type="button" id="confirm" class="confirm">確定</button>'+
        '</div>'+
        '</div>';
    $('body').append(tpl);
    $(document).on('click', '.confirm', function() {
        $('.container').remove();
        callback();
    });
}
